# Copy to .env and fill in. NEVER commit .env.
# Wallet private key (hex, no 0x prefix needed) — funds the Polygon proxy wallet.
POLYMARKET_PRIVATE_KEY=

# L2 API credentials (derive once via py-clob-client create_or_derive_api_creds()).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Funder address (Polymarket proxy wallet) if different from signer EOA.
POLYMARKET_FUNDER_ADDRESS=

# Hard interlock: live order submission refuses to start unless this exact value is set.
# Leave empty until M2 GO decision is signed off.
ENABLE_LIVE_TRADING=
